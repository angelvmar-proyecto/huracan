<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
    <title>🌊 Huracanes MX Pro</title>
    <link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" />
    <link rel="stylesheet" href="css/style.css">

    <style>
    #nhc-btn {
        position: fixed;
        top: 70px;
        left: 12px;
        z-index: 900;
        width: 46px;
        height: 46px;
        border-radius: 50%;
        background: rgba(15,23,42,0.92);
        border: 2px solid rgba(255,255,255,0.25);
        color: #fff;
        font-size: 22px;
        cursor: pointer;
        display: flex;
        align-items: center;
        justify-content: center;
        box-shadow: 0 4px 14px rgba(0,0,0,0.6);
        transition: all 0.2s;
        padding: 0;
    }
    #nhc-btn:active { transform: scale(0.92); }
    #nhc-btn.active {
        background: #f59e0b;
        border-color: #f59e0b;
        box-shadow: 0 0 24px rgba(245,158,11,0.7);
    }
    #nhc-btn.loading {
        animation: nhcPulse 1s ease-in-out infinite;
    }
    @keyframes nhcPulse {
        0%, 100% { opacity: 1; }
        50% { opacity: 0.45; }
    }
    </style>
</head>
<body>

    <nav class="weather-tabs">
        <button class="tab-btn active" onclick="switchTab('trayectoria', event)">🌀 Trayectoria</button>
        <button class="tab-btn" onclick="switchTab('radar', event)">📡 Radar</button>
        <button class="tab-btn" onclick="switchTab('alertas', event)">🚨 Alertas</button>
        <button class="tab-btn" onclick="switchTab('pronostico', event)">⛅ Clima Local</button>
        <button class="tab-btn" onclick="switchTab('seguridad', event)">🛡️ Seguridad</button>
    </nav>

    <!-- PANEL 1: TRAYECTORIA -->
    <div id="panel-trayectoria" class="weather-panel active">
        <div id="map"></div>
        <button id="nhc-btn" onclick="toggleNHC()" title="Capas oficiales NHC">🛰️</button>
        <div class="info-card-floating" id="info-card-mapa" style="display:none;"></div>
    </div>

    <!-- PANEL 2: RADAR (CAPAS ILUSTRATIVAS) -->
    <div id="panel-radar" class="weather-panel">
        <div class="panel-content-inner">
            <h2 class="titulo-panel" style="font-size:18px; margin-bottom:12px;">📡 Capas Visuales</h2>
            <p class="sub-texto" style="margin-bottom:16px;">
                Capas decorativas. No representan datos satelitales ni de radar en tiempo real.
            </p>

            <div class="card-option" onclick="aplicarCapaRadar('infrarrojo')">
                <div style="font-weight:600; color:#f59e0b;">🛰️ Nubes (ilustrativo)</div>
                <div class="sub-texto">Icono de referencia</div>
            </div>
            <div class="card-option" style="margin-top:12px;" onclick="aplicarCapaRadar('vientos')">
                <div style="font-weight:600; color:#f59e0b;">💨 Viento (ilustrativo)</div>
                <div class="sub-texto">Icono de referencia</div>
            </div>
            <div class="card-option" style="margin-top:12px;" onclick="aplicarCapaRadar('precipitacion')">
                <div style="font-weight:600; color:#f59e0b;">🌧️ Lluvia (ilustrativo)</div>
                <div class="sub-texto">Icono de referencia</div>
            </div>
        </div>
    </div>

    <!-- PANEL 3: ALERTAS DINÁMICAS -->
    <div id="panel-alertas" class="weather-panel">
        <div class="panel-content-inner">
            <h2 class="titulo-panel" style="font-size:18px; margin-bottom:6px;">🚨 Sistemas Activos</h2>
            <p class="sub-texto" style="margin-bottom:14px;">
                Datos NHC/NOAA. Toca cualquier tarjeta para abrir el boletín oficial del SMN.
            </p>

            <div id="lista-alertas-dinamicas">
                <div class="sub-texto">Cargando…</div>
            </div>

            <hr style="border:0; border-top:1px solid rgba(255,255,255,0.15); margin:16px 0;">
            <p class="sub-texto" style="margin-bottom:12px;">Boletines oficiales:</p>

            <div class="alert-card warning" onclick="abrirBoletinOficial('smn')" style="cursor:pointer;">
                <div style="font-weight:bold; color:#f59e0b;">🟡 Ciclones Tropicales (SMN) ↗</div>
                <div class="sub-texto" style="margin-top:4px;">
                    Servicio Meteorológico Nacional.
                </div>
            </div>
            <div class="alert-card info" onclick="abrirBoletinOficial('puertos')"
                 style="cursor:pointer; margin-top:12px;">
                <div style="font-weight:bold; color:#f59e0b;">⚓ Avisos a Puertos (SEMAR) ↗</div>
                <div class="sub-texto" style="margin-top:4px;">
                    Secretaría de Marina.
                </div>
            </div>
            <div class="alert-card info" onclick="abrirBoletinOficial('aviso_general')"
                 style="cursor:pointer; margin-top:12px; border-left:4px solid #3b82f6;">
                <div style="font-weight:bold; color:#3b82f6;">🔵 Pronóstico General (CONAGUA) ↗</div>
                <div class="sub-texto" style="margin-top:4px;">
                    Reporte nacional del clima.
                </div>
            </div>
        </div>
    </div>

    <!-- PANEL 4: CLIMA LOCAL -->
    <div id="panel-pronostico" class="weather-panel">
        <!-- Generado dinámicamente por app.js -->
    </div>

    <!-- PANEL 5: SEGURIDAD -->
    <div id="panel-seguridad" class="weather-panel">
        <div class="panel-content-inner">
            <h2 class="titulo-panel" style="font-size:18px; margin-bottom:12px;">🛡️ Protocolos y Emergencia</h2>

            <a href="tel:911" class="action-btn red"
               style="text-decoration:none; display:block; text-align:center;">
                📞 Llamar al 911
            </a>

            <a href="https://www.gob.mx/cenapred" target="_blank" rel="noopener"
               class="action-btn blue" style="margin-top:12px; text-decoration:none;
               display:block; text-align:center;">
                🏫 Protección Civil (refugios)
            </a>

            <a href="https://www.gob.mx/cenapred" target="_blank" rel="noopener"
               class="action-btn" style="margin-top:12px; text-decoration:none;
               display:block; text-align:center; background:#10b981; color:#fff;">
                📋 Recomendaciones CENAPRED
            </a>
        </div>
    </div>

    <script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"></script>
    <script src="js/app.js"></script>
</body>
</html>
